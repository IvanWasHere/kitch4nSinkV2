# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=                                      # node ace generate:key
APP_URL=http://${HOST}:${PORT}
APP_NAME="Acme"

# Session
SESSION_DRIVER=cookie

# Database — sqlite locally, postgres deployed
DB_CONNECTION=sqlite                          # sqlite | postgres
DB_SQLITE_PATH=./tmp/db.sqlite3
# DATABASE_URL=postgres://user:pass@host:5432/db
# DB_HOST=  DB_PORT=  DB_USER=  DB_PASSWORD=  DB_DATABASE=  DB_SSL=true

# Mail
MAIL_MAILER=smtp                              # smtp (Mailpit) locally | resend in prod
MAIL_FROM_ADDRESS=onboarding@resend.dev       # replace once your domain is verified in Resend
MAIL_FROM_NAME="Acme"
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
SMTP_HOST=localhost                           # Mailpit
SMTP_PORT=1025

# Payments (M4)
PAYMENT_PROVIDER=creem
CREEM_API_KEY=
CREEM_API_URL=https://test-api.creem.io       # live: https://api.creem.io
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_PRO=
CREEM_PRODUCT_BUSINESS=

# Storage (M5)
DRIVE_DISK=fs                                 # fs locally | r2 in prod
DRIVE_FS_ROOT=storage                         # where the local fs disks live, relative to the app root
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=                                  # https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=                                # custom domain fronting the public disk

# OAuth (M1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Back-office (M7)
ADMIN_IP_ALLOWLIST=                           # comma-separated; empty disables the check

# Rate limiting (M6)
LIMITER_STORE=database                        # database | memory (tests)

# Security headers and proxies (M8)
# TRUST_PROXY decides what request.ip() returns, and therefore what every rate
# limit counts against and what the audit trail records. Turn it on only when a
# proxy you control sits in front of this process; it trusts one hop, which is
# one short if a CDN sits in front of that proxy — see config/app.ts.
TRUST_PROXY=false
CSP_REPORT_ONLY=false                         # report violations without blocking, while tightening the policy

# Queue (M3)
QUEUE_WORKER_CONCURRENCY=5
QUEUE_POLL_INTERVAL_MS=1000

# Development conveniences — leave unset anywhere that is not a laptop.
# Accepted in place of a real authenticator code, and only while
# NODE_ENV=development. Unset it and two-factor behaves normally.
DEV_TWO_FACTOR_CODE=123456