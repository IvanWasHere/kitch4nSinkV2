  x: '<line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />',
})
@let(name = $props.get('name'))

<svg {{
  $props
    .except(['name'])
    .merge({
      viewBox: '0 0 24 24',
      fill: 'none',
      stroke: 'currentColor',
      'stroke-width': 2,
      'stroke-linecap': 'round',
      'stroke-linejoin': 'round',
      'aria-hidden': 'true',
      focusable: 'false',
    })
    .toAttrs()
}}>{{{ paths[name] || '' }}}</svg>
