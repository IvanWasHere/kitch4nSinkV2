@let(labelTextFromSlot = await $slots.main())
@let(classes = ['field-label'])

<label {{
  $props
    .except(['text'])
    .merge({
      for: $context.id,
      class: classes,
      'data-invalid': $context.hasErrors ? 'true' : false,
    })
    .toAttrs()
}}>
  {{-- Slot markup is printed as-is; a `text` prop is escaped (see badge.edge). --}}
  @if(labelTextFromSlot.trim())
    {{{ labelTextFromSlot }}}
  @else
    {{ $props.get('text') ?? '' }}
  @end
</label>
