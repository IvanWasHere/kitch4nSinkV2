@component('emails/layout', {
  title: 'Payment failed',
  footer: 'You are receiving this because you own this workspace.',
})
  <p style="margin: 0 0 12px; font-size: 20px; font-weight: 700; color: #111827;">
    We could not take payment
  </p>
  <p style="margin: 0 0 20px; font-size: 14px; line-height: 1.6; color: #4b5563;">
    The last charge for {{ organization.name }} was declined. <strong>Nothing has been taken
    away</strong> — your team, your lists and your todos are exactly where they were, and everyone
    can keep working.
  </p>
  <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 0 0 24px; border: 1px solid #fde68a; border-radius: 8px; background: #fffbeb;">
    <tr>
      <td style="padding: 14px 16px; font-size: 13px; line-height: 1.6; color: #92400e;">
        @if(graceEndsAt)
          Updating your card before {{ graceEndsAt.toFormat('d LLLL') }} keeps everything as it is.
          After that the workspace moves to the Free plan — still nothing deleted, but new lists
          and new team members will be capped.
        @else
          Updating your card keeps everything as it is. Until then the workspace stays on its
          current plan.
        @end
      </td>
    </tr>
  </table>
  <p style="margin: 0 0 24px;">
    <a href="{{ url }}" style="display: inline-block; background: #3b82f6; color: #ffffff; text-decoration: none; font-size: 14px; font-weight: 600; padding: 12px 20px; border-radius: 8px;">
      Update payment method
    </a>
  </p>
@end
