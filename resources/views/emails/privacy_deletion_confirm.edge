@component('emails/layout', { title: 'Confirm your account deletion request' })
  <p style="margin: 0 0 12px; font-size: 20px; font-weight: 700; color: #111827;">
    Confirm your account deletion request
  </p>
  <p style="margin: 0 0 20px; font-size: 14px; line-height: 1.6; color: #4b5563;">
    Hi{{ user.fullName ? ` ${user.fullName}` : '' }}, somebody — hopefully you — asked us to delete
    this account. Confirm it below and our team will review the request. Nothing is deleted until
    they do.
  </p>
  <p style="margin: 0 0 24px;">
    <a href="{{ url }}" style="display: inline-block; background: #dc2626; color: #ffffff; text-decoration: none; font-size: 14px; font-weight: 600; padding: 12px 20px; border-radius: 8px;">
      Confirm deletion request
    </a>
  </p>
  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #6b7280;">
    This link works once and expires in 24 hours. If you did not ask for this, ignore this email —
    nothing will happen — and consider securing the account you sign in with.
  </p>
@end
