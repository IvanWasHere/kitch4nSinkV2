@component('emails/layout', {
  title: 'You have been invited',
  footer: 'If you were not expecting this, you can ignore it — the invitation expires on its own.',
})
  <p style="margin: 0 0 12px; font-size: 20px; font-weight: 700; color: #111827;">
    Join {{ organization.name }}
  </p>
  <p style="margin: 0 0 20px; font-size: 14px; line-height: 1.6; color: #4b5563;">
    {{ invitedBy.displayName }} invited you to join the {{ organization.name }} workspace.
  </p>
  <p style="margin: 0 0 24px;">
    <a href="{{ url }}" style="display: inline-block; background: #3b82f6; color: #ffffff; text-decoration: none; font-size: 14px; font-weight: 600; padding: 12px 20px; border-radius: 8px;">
      Accept invitation
    </a>
  </p>
  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #6b7280;">
    This invitation expires in 14 days. If the button does not work, paste this into your
    browser:<br />
    <a href="{{ url }}" style="color: #2563eb; word-break: break-all;">{{ url }}</a>
  </p>
@end
