@component('emails/layout', {
  title: 'Payment receipt',
  footer: 'You are receiving this because you own this workspace.',
})
  <p style="margin: 0 0 12px; font-size: 20px; font-weight: 700; color: #111827;">
    Payment received
  </p>
  <p style="margin: 0 0 20px; font-size: 14px; line-height: 1.6; color: #4b5563;">
    We have taken {{ amount }} for {{ organization.name }}. Nothing else is needed from you.
  </p>
  <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; margin: 0 0 24px; border: 1px solid #e5e7eb; border-radius: 8px;">
    <tr>
      <td style="padding: 12px 16px; font-size: 13px; color: #6b7280; border-bottom: 1px solid #f3f4f6;">Amount</td>
      <td style="padding: 12px 16px; font-size: 13px; font-weight: 700; color: #111827; text-align: right; border-bottom: 1px solid #f3f4f6;">{{ amount }}</td>
    </tr>
    <tr>
      <td style="padding: 12px 16px; font-size: 13px; color: #6b7280; border-bottom: 1px solid #f3f4f6;">Date</td>
      <td style="padding: 12px 16px; font-size: 13px; color: #111827; text-align: right; border-bottom: 1px solid #f3f4f6;">{{ paidAt.toFormat('d LLLL yyyy') }}</td>
    </tr>
    <tr>
      <td style="padding: 12px 16px; font-size: 13px; color: #6b7280;">Reference</td>
      <td style="padding: 12px 16px; font-size: 12px; color: #111827; text-align: right; font-family: monospace;">{{ payment.publicId }}</td>
    </tr>
  </table>
  <p style="margin: 0 0 24px;">
    <a href="{{ payment.receiptUrl ?? url }}" style="display: inline-block; background: #3b82f6; color: #ffffff; text-decoration: none; font-size: 14px; font-weight: 600; padding: 12px 20px; border-radius: 8px;">
      {{ payment.receiptUrl ? 'View invoice' : 'View billing' }}
    </a>
  </p>
@end
