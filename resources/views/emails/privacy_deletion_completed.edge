@component('emails/layout', { title: 'Your account has been deleted' })
  <p style="margin: 0 0 12px; font-size: 20px; font-weight: 700; color: #111827;">
    Your account has been deleted
  </p>
  <p style="margin: 0 0 16px; font-size: 14px; line-height: 1.6; color: #4b5563;">
    @if(because === 'workspace_deleted')
      The owner of your workspace asked for it to be deleted, and your account was deleted with it.
      You can no longer sign in, and this is the last email we will send to this address about it.
    @else
      As you asked, we have deleted your account. You can no longer sign in with it, and this is
      the last email we will send to this address about it.
    @end
  </p>
  <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #6b7280;">
    Some records are kept because we have to — payments and invoices, and the security log — but
    they no longer carry your name or email address.
  </p>
@end
