{{--
  The signed-in tenant shell: sidebar, topbar, content.

  Props:
    title     — page <title> and the topbar heading
    usage     — plan usage passed through to the sidebar (plan §13.6.1)
    isOwner   — whether the current user owns the organisation

  Slots:
    main      — the page
    actions   — optional buttons rendered on the right of the topbar
    banner    — optional extra banner (impersonation, M7). The billing-state
                banner is rendered by this layout and needs no slot.
--}}
@component('layouts/base', { title: $props.get('title') })
  {{--
    Above the shell, not inside it, so it is the first thing on the page on
    every screen and cannot be scrolled past (plan §6).
  --}}
  @include('partials/impersonation_banner')

  <div class="dash-layout" x-data="sidebar">
    <aside class="dash-sidebar" :class="open && 'open'">
      <div class="dash-sidebar-logo">
        <a href="{{ hasRoute('dashboard.index') ? urlFor('dashboard.index') : urlFor('home') }}" class="logo">
          {{--
            A workspace that uploaded a logo gets it here; everyone else keeps
            the product mark. Public disk, so this is a plain cacheable URL —
            a signed one would expire while somebody had the page open.
          --}}
          @if(organization && organization.logoKey)
            <img
              class="logo-image"
              src="{{ await publicFileUrl(organization.logoKey) }}"
              alt="{{ organization.name }}"
            />
          @else
            <span class="logo-icon">
              @!icon({ name: 'layers' })
            </span>
          @end
          <span class="logo-text">{{ organization ? organization.name : appName }}</span>
        </a>
      </div>

      <nav class="dash-sidebar-nav" aria-label="Main">
        @include('partials/app_nav')
      </nav>

      <div class="dash-sidebar-footer">
        @if(auth.user)
          {{--
            The profile block doubles as the notifications entry point
            (plan §20.5): unread announcements put a red dot on the avatar and
            the row leads to the feed instead of the profile. The dot changing
            where the row goes is what makes it worth looking at.

            `unreadNotifications` and `notificationsUrl` are both shared by
            `require_organization` — derived there rather than with `@let`
            here, so the shell has no logic of its own to get wrong.
          --}}
          <a
            href="{{ notificationsUrl ?? (hasRoute('settings.profile') ? urlFor('settings.profile') : '#') }}"
            class="sidebar-user"
          >
            <span class="sidebar-user-avatar">
              @!avatar({
                initials: auth.user.initials,
                src: await publicFileUrl(auth.user.avatarKey),
                alt: auth.user.fullName ?? auth.user.email,
              })
              @if(unreadNotifications)
                <span class="notif-dot" aria-hidden="true"></span>
              @end
            </span>

            <span class="sidebar-user-info">
              <span class="sidebar-user-name">{{ auth.user.fullName ?? auth.user.email }}</span>
              <span class="sidebar-user-email">
                @if(unreadNotifications)
                  {{ unreadNotifications }} new
                  {{ unreadNotifications === 1 ? 'announcement' : 'announcements' }}
                @else
                  {{ auth.user.email }}
                @end
              </span>
            </span>
          </a>
        @end
      </div>
    </aside>

    {{-- Closes the drawer on tap below 768px --}}
    <div class="sidebar-overlay" :class="open && 'open'" @click="close" x-cloak></div>

    <div class="dash-main">
      {{--
        Billing state, on every screen (plan §7.5). In the layout rather than
        passed down per page, because a banner a page can forget to render is
        a banner that is missing on the page where it matters.
      --}}
      @if(organization)
        @include('partials/account_banner')
      @end

      @if($slots.banner)
        {{{ await $slots.banner() }}}
      @end

      <header class="dash-topbar">
        <div class="dash-topbar-inner">
        <div style="display: flex; align-items: center; gap: 12px">
          <button type="button" class="mobile-toggle" @click="toggle" aria-label="Open navigation">
            @!icon({ name: 'menu', width: 18, height: 18 })
          </button>
          <h1 class="dash-topbar-title">{{ $props.get('title') ?? '' }}</h1>
        </div>

        <div class="dash-topbar-actions">
          @if($slots.actions)
            {{{ await $slots.actions() }}}
          @end

          @form({ route: 'auth.session.destroy', method: 'POST' })
            <button type="submit" class="topbar-icon-btn" aria-label="Sign out">
              @!icon({ name: 'logOut', width: 16, height: 16 })
            </button>
          @end
        </div>
        </div>
      </header>

      <main class="dash-content">
        {{{ await $slots.main() }}}
      </main>
    </div>
  </div>
@end
