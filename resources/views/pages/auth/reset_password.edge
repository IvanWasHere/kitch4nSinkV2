@component('layouts/auth', {
  title: 'Choose a new password',
  heading: 'Choose a new password',
  subtitle: 'This link works once and expires in an hour',
})
  @form({ route: 'auth.password.update', routeParams: { token: token }, method: 'POST' })
    @field.root({ name: 'password' })
      @!field.label({ text: 'New password' })
      <div x-data="passwordStrength">
        <div class="input-wrap">
          @!input.control({
            type: 'password',
            placeholder: 'At least 12 characters',
            autocomplete: 'new-password',
            'x-model': 'value',
            'x-bind:type': 'type',
          })
          <button type="button" class="pw-toggle" @click="toggle" x-text="toggleLabel">Show</button>
        </div>
        <div class="strength-bar">
          <div class="strength-fill" :data-score="score" data-score="0"></div>
        </div>
        <div class="strength-text" x-text="label"></div>
      </div>
      @!field.error()
    @end

    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirm new password' })
      @!input.control({ type: 'password', autocomplete: 'new-password' })
      @!field.error()
    @end

    @!button({ text: 'Set new password', type: 'submit', block: true })
  @end
@end
