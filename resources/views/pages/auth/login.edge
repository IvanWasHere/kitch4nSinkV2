@component('layouts/auth', {
  title: 'Sign in',
  heading: 'Sign in to your account',
  subtitle: 'Enter your credentials to access your workspace',
})
  @form({ route: 'auth.session.store', method: 'POST' })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Email address' })
      @!input.control({ type: 'email', placeholder: 'you@example.com', autocomplete: 'email' })
      @!field.error()
    @end

    @field.root({ name: 'password' })
      @!field.label({ text: 'Password' })
      <div class="input-wrap" x-data="passwordField">
        @!input.control({
          type: 'password',
          placeholder: 'Enter your password',
          autocomplete: 'current-password',
          'x-bind:type': 'type',
        })
        <button type="button" class="pw-toggle" @click="toggle" x-text="toggleLabel">Show</button>
      </div>
      @!field.error()
    @end

    <div class="check-row">
      <input type="checkbox" id="rememberMe" name="rememberMe" value="1" />
      <label for="rememberMe">Keep me signed in on this device</label>
    </div>

    @!button({ text: 'Sign in', type: 'submit', block: true })
  @end

  <p class="auth-footer">
    <a href="{{ urlFor('auth.password.create') }}" class="btn-ghost">Forgot your password?</a>
  </p>

  @!auth.socialButtons({ providers: socialProviders, action: 'Sign in' })

  <div class="divider">new here?</div>

  @!link({
    route: 'auth.register.create',
    text: 'Create a new account',
    class: 'btn btn-outline btn-block',
  })
@end
