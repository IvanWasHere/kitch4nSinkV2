@component('layouts/auth', {
  title: 'Reset your password',
  heading: 'Reset your password',
  subtitle: "Enter your email and we'll send you a reset link",
  back: { route: 'auth.session.create', text: 'Back to sign in' },
})
  <div class="info-box">
    If an account exists with that address, you will receive a reset link within a few minutes.
  </div>

  @form({ route: 'auth.password.store', method: 'POST' })
    @field.root({ name: 'email' })
      @!field.label({ text: 'Email address' })
      @!input.control({ type: 'email', placeholder: 'you@example.com', autocomplete: 'email' })
      @!field.error()
    @end

    @!button({ text: 'Send reset link', type: 'submit', block: true })
  @end
@end
