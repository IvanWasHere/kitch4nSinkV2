@component('layouts/auth', {
  title: 'Accept invitation',
  heading: `Join ${organization.name}`,
  subtitle: `Set up your account for ${invitation.email}`,
})
  <div class="info-box">
    Everyone in this workspace can see and edit every list. Your email address is already
    confirmed by following this link.
  </div>

  @form({ route: 'invitations.accept', routeParams: { token: token }, method: 'POST' })
    @field.root({ name: 'fullName' })
      @!field.label({ text: 'Full name' })
      @!input.control({ placeholder: 'Jane Cooper', autocomplete: 'name' })
      @!field.error()
    @end

    @field.root({ name: 'password' })
      @!field.label({ text: 'Password' })
      <div x-data="passwordStrength">
        <div class="input-wrap">
          @!input.control({
            type: 'password',
            placeholder: 'At least 12 characters',
            autocomplete: 'new-password',
            'x-model': 'value',
            'x-bind:type': 'type',
          })
          <button type="button" class="pw-toggle" @click="toggle" x-text="toggleLabel">Show</button>
        </div>
        <div class="strength-bar">
          <div class="strength-fill" :data-score="score" data-score="0"></div>
        </div>
        <div class="strength-text" x-text="label"></div>
      </div>
      @!field.error()
    @end

    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirm password' })
      @!input.control({ type: 'password', autocomplete: 'new-password' })
      @!field.error()
    @end

    @!button({ text: 'Join workspace', type: 'submit', block: true })
  @end
@end
