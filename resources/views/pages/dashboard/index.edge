@component('layouts/app', { title: 'Overview' })
  @slot('actions')
    @!link({ route: 'lists.index', text: 'Lists', class: 'btn btn-outline btn-sm' })
  @end

  <div class="stats-grid">
    @!statCard({ label: 'Lists', value: stats.lists, icon: 'list', tone: 'blue' })
    @!statCard({ label: 'Open todos', value: stats.openTodos, icon: 'package', tone: 'purple' })
    @!statCard({
      label: 'Completed this week',
      value: stats.completedThisWeek,
      icon: 'check',
      tone: 'green',
    })
    @!statCard({
      label: 'Overdue',
      value: stats.overdue,
      icon: 'clock',
      tone: stats.overdue > 0 ? 'red' : 'green',
    })
  </div>

  {{--
    Plan usage (plan §7.4). Driven by the same PlanService numbers as
    enforcement, which is the only reason a meter is worth showing: a gauge
    that disagrees with the block is worse than no gauge.
  --}}
  @panel.root({ title: `Usage on the ${usage.plan.name} plan`, style: 'margin-bottom: 20px' })
    @slot('actions')
      @if(isOwner && hasRoute('billing.index'))
        @!link({ route: 'billing.index', text: 'Billing', class: 'btn-ghost' })
      @end
    @end
    <div class="usage-grid">
      @!usageMeter({ label: 'Lists', current: usage.lists.current, limit: usage.lists.limit })
      @!usageMeter({ label: 'Seats', current: usage.seats.current, limit: usage.seats.limit })
      @!usageMeter({
        label: 'Storage (MB)',
        current: usage.storage.current,
        limit: usage.storage.limit,
      })
    </div>
  @end

  <div class="panel-grid">
    @panel.root({ title: 'Recent todos', flush: true })
      @slot('actions')
        @!link({ route: 'lists.index', text: 'All lists', class: 'btn-ghost' })
      @end

      @if(recent.length)
        <div class="table-scroll">
          <table class="orders-table">
            <thead>
              <tr>
                <th>Todo</th>
                <th>List</th>
                <th>Assignee</th>
                <th>Due</th>
              </tr>
            </thead>
            <tbody>
              @each(todo in recent)
                <tr>
                  <td>
                    <a
                      class="order-id"
                      href="{{ urlFor('lists.show', { id: todo.todoList.publicId }) }}"
                    >{{ todo.title }}</a>
                  </td>
                  <td>{{ todo.todoList.name }}</td>
                  <td>{{ todo.assignedTo ? todo.assignedTo.displayName : 'Unassigned' }}</td>
                  <td>
                    @if(todo.dueAt)
                      <span class="{{ todo.isOverdue ? 'nav-usage full' : '' }}">
                        {{ todo.dueAt.setZone(organization.timezone).toFormat('d LLL') }}
                      </span>
                    @else
                      <span class="field-hint">—</span>
                    @end
                  </td>
                </tr>
              @end
            </tbody>
          </table>
        </div>
      @else
        @!emptyState({
          icon: 'list',
          title: `Welcome to ${organization.name}`,
          description: 'Create a list and everyone in the workspace can start adding to it.',
        })
      @end
    @end

    @panel.root({ title: 'Recently finished' })
      @if(activity.length)
        @each(todo in activity)
          <div class="activity-item">
            <span class="activity-dot activity-dot-green"></span>
            <div>
              <p class="activity-text">
                <strong>{{ todo.completedBy ? todo.completedBy.displayName : 'Someone' }}</strong>
                finished {{ todo.title }} in {{ todo.todoList.name }}
              </p>
              <p class="activity-time">{{ todo.completedAt.toRelative() }}</p>
            </div>
          </div>
        @end
      @else
        <p class="field-hint">Nothing finished yet. Ticking a todo will show up here.</p>
      @end
    @end
  </div>
@end
