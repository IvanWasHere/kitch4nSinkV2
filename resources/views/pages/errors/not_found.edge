@component('layouts/auth', { title: 'Page not found' })
  <div class="status-page">
    <p class="status-code">404</p>
    <h1 class="auth-title">We couldn't find that page</h1>
    <p class="auth-subtitle">
      The link may be out of date, or the item may have been deleted.
    </p>
    @!link({ route: 'home', text: 'Back to safety', class: 'btn btn-primary btn-block' })
  </div>
@end
