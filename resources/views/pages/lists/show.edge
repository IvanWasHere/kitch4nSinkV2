{{--
  List detail — the mockup's orders table, with priority as the badge
  (plan §13.5).

  Reordering is a drag on each row, but every row also carries plain Move up /
  Move down forms: with JavaScript off the list is still orderable, which is
  the rule for every interaction here (plan §13.3).
--}}
@component('layouts/app', { title: list.name })
  @slot('actions')
    @form({ route: 'lists.archive', routeParams: { id: list.publicId }, method: 'POST' })
      @!button({
        text: list.isArchived ? 'Unarchive' : 'Archive',
        variant: 'outline',
        size: 'sm',
        type: 'submit',
      })
    @end
    @if(auth.user.isOwner)
      @form({ route: 'lists.destroy', routeParams: { id: list.publicId }, method: 'POST' })
        @!button({ text: 'Delete list', variant: 'danger', size: 'sm', type: 'submit' })
      @end
    @end
  @end

  <div class="page-header">
    <div>
      <h2 class="section-title">
        {{ list.name }}
        @if(list.isArchived)
          @!badge({ text: 'Archived', tone: 'neutral' })
        @end
      </h2>
      <p class="section-desc" style="margin-bottom: 0">
        {{ list.description || 'Everyone in this workspace can see and edit these.' }}
      </p>
    </div>
    <div class="pillset">
      <a
        class="pill {{ filter === 'all' ? 'active' : '' }}"
        href="{{ urlFor('lists.show', { id: list.publicId }) }}"
      >All</a>
      <a
        class="pill {{ filter === 'open' ? 'active' : '' }}"
        href="{{ urlFor('lists.show', { id: list.publicId }) }}?filter=open"
      >Open</a>
      <a
        class="pill {{ filter === 'done' ? 'active' : '' }}"
        href="{{ urlFor('lists.show', { id: list.publicId }) }}?filter=done"
      >Done</a>
    </div>
  </div>

  {{--
    The per-list cap (plan §7.4). At the ceiling the form is replaced by the
    upsell rather than left there to fail on submit — and it says the thing
    that otherwise reads as a bug: **completed todos still count**. A fully
    ticked-off list at its cap is still full, and the way out is to delete or
    move them, not to tick more.
  --}}
  @if(todoUsage.isFull)
    <div class="info-box info-box-warning">
      <p>
        <strong>
          This list holds all {{ todoUsage.limit }} todos your plan allows in one list.
        </strong>
      </p>
      <p>
        Completed todos still count — ticking one off does not free a slot. Delete the ones you are
        done with, move some into another list,
        @if(isOwner && hasRoute('billing.index'))
          or <a href="{{ urlFor('billing.index') }}">upgrade for a higher cap</a>.
        @else
          or ask the workspace owner to upgrade.
        @end
      </p>
    </div>
  @end

  @if(!list.isArchived && !todoUsage.isFull)
    <div class="settings-card">
      @if(todoUsage.isNearLimit)
        <p class="field-hint" style="margin-bottom: 12px">
          {{ todoUsage.current }} of {{ todoUsage.limit }} todos used in this list. Completed ones
          still count.
        </p>
      @end
      @form({ route: 'todos.store', routeParams: { listId: list.publicId }, method: 'POST' })
        <div class="field-row" style="grid-template-columns: 2fr 1fr 1fr 1fr">
          @field.root({ name: 'title' })
            @!field.label({ text: 'Add a todo' })
            @!input.control({ placeholder: 'What needs doing' })
            @!field.error()
          @end

          @field.root({ name: 'priority' })
            @!field.label({ text: 'Priority' })
            @!select.control({
              options: [
                { value: 'normal', name: 'Normal' },
                { value: 'low', name: 'Low' },
                { value: 'high', name: 'High' },
              ],
            })
          @end

          @field.root({ name: 'dueAt' })
            @!field.label({ text: 'Due' })
            @!input.control({ type: 'date' })
          @end

          @field.root({ name: 'assignedTo' })
            @!field.label({ text: 'Assignee' })
            @!select.control({
              options: [{ value: '', name: 'Unassigned' }].concat(
                members.map((member) => ({ value: member.publicId, name: member.displayName }))
              ),
            })
          @end
        </div>

        <div class="btn-row">
          @!button({ text: 'Add todo', type: 'submit', size: 'sm' })
        </div>
      @end
    </div>
  @end

  @panel.root({ title: 'Todos', flush: true })
    @if(todos.length)
      <div class="table-scroll">
        <table class="orders-table">
          <thead>
            <tr>
              <th></th>
              <th>Todo</th>
              <th>Assignee</th>
              <th>Priority</th>
              <th>Due</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @each(todo in todos)
              <tr>
                <td>
                  @form({ route: 'todos.complete', routeParams: { id: todo.publicId }, method: 'POST' })
                    @!button({
                      text: todo.isComplete ? '✓' : '○',
                      variant: todo.isComplete ? 'primary' : 'outline',
                      size: 'xs',
                      type: 'submit',
                      title: todo.isComplete ? 'Mark as not done' : 'Mark as done',
                    })
                  @end
                </td>
                <td>
                  <span style="{{ todo.isComplete ? 'text-decoration: line-through; color: var(--slate-400)' : '' }}">
                    {{ todo.title }}
                  </span>
                  @if(todo.notes)
                    <br /><span class="field-hint">{{ todo.notes }}</span>
                  @end
                </td>
                <td>
                  {{ todo.assignedTo ? todo.assignedTo.displayName : 'Unassigned' }}
                </td>
                <td>
                  @!badge({
                    text: todo.priority === 'high' ? 'High' : todo.priority === 'low' ? 'Low' : 'Normal',
                    tone: todo.priority === 'high' ? 'danger' : todo.priority === 'low' ? 'neutral' : 'info',
                  })
                </td>
                <td>
                  @if(todo.dueAt)
                    <span class="{{ todo.isOverdue ? 'nav-usage full' : '' }}">
                      {{ todo.dueAt.setZone(organization.timezone).toFormat('d LLL') }}
                    </span>
                  @else
                    <span class="field-hint">—</span>
                  @end
                </td>
                <td>
                  <div class="table-actions">
                    @form({ route: 'todos.destroy', routeParams: { id: todo.publicId }, method: 'POST' })
                      @!button({ text: 'Delete', variant: 'danger', size: 'xs', type: 'submit' })
                    @end
                  </div>
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    @else
      @!emptyState({
        icon: 'check',
        title: filter === 'done' ? 'Nothing finished yet' : 'This list is empty',
        description: 'Todos added here are visible to everyone in the workspace.',
      })
    @end
  @end
@end
