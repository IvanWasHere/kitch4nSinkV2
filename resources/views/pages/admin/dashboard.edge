{{--
  The back-office dashboard (plan §12).

  Ordered by what somebody opening it needs. **What is broken** comes first:
  a dashboard that leads with MRR is a dashboard nobody opens during an
  incident.
--}}
@component('layouts/admin', { title: 'Dashboard' })
  @if(metrics.failedJobs > 0 || metrics.unprocessedWebhooks > 0 || attention.length > 0)
    <div class="info-box info-box-warning">
      <p><strong>Needs attention</strong></p>
      <p>
        @if(metrics.failedJobs > 0)
          <a href="{{ urlFor('admin.jobs.index') }}">{{ metrics.failedJobs }} failed job{{ metrics.failedJobs === 1 ? '' : 's' }}</a>.
        @end
        @if(metrics.unprocessedWebhooks > 0)
          <a href="{{ urlFor('admin.webhooks.index') }}">{{ metrics.unprocessedWebhooks }} webhook{{ metrics.unprocessedWebhooks === 1 ? '' : 's' }} never applied</a> —
          a customer's entitlements and their invoice may disagree.
        @end
        @if(attention.length > 0)
          {{ attention.length }} workspace{{ attention.length === 1 ? '' : 's' }} past due or suspended.
        @end
      </p>
    </div>
  @end

  <div class="stats-grid">
    @!statCard({
      label: 'MRR',
      value: `$${(metrics.mrrCents / 100).toFixed(0)}`,
      icon: 'creditCard',
      tone: 'green',
    })
    @!statCard({ label: 'Active subscriptions', value: metrics.activeSubscriptions, icon: 'check', tone: 'blue' })
    @!statCard({
      label: 'Past due',
      value: metrics.pastDueSubscriptions,
      icon: 'alert',
      tone: metrics.pastDueSubscriptions > 0 ? 'red' : 'green',
    })
    {{--
      Signups are counted in the strip below, so the fourth card carries the
      number that has nowhere else to go: cancellations over the subscriptions
      that could have cancelled.
    --}}
    @!statCard({
      label: 'Churn, 30 days',
      value: metrics.churnRate === null ? '—' : `${(metrics.churnRate * 100).toFixed(1)}%`,
      icon: 'trendingUp',
      tone: metrics.churnRate !== null && metrics.churnRate >= 0.05 ? 'red' : 'green',
    })
  </div>

  <p class="field-hint section-note">
    MRR is the list price of every entitling subscription, `past_due` included — we are still
    trying to collect. It knows nothing about discounts or proration, because nothing here sells
    them yet.
  </p>

  {{--
    Volume through the account (plan §12). The window is a query string, so
    every range is a link somebody can send.
  --}}
  <div class="page-header" style="align-items: center">
    <div>
      <h2 class="section-title">Volume</h2>
      <p class="section-desc" style="margin-bottom: 0">
        Charges through the account over the last {{ revenue.days }} days, in {{ revenue.currency }}.
      </p>
    </div>

    <div class="seg">
      @each(one in ranges)
        <a
          href="{{ urlFor('admin.dashboard') }}?range={{ one }}"
          class="{{ revenue.range === one ? 'active' : '' }}"
        >{{ one.toUpperCase() }}</a>
      @end
    </div>
  </div>

  <div class="stats-grid" style="grid-template-columns: repeat(3, 1fr)">
    @!moneyCard({
      label: 'Gross volume',
      amount: money(revenue.gross.cents, revenue.currency, true),
      previous: money(revenue.gross.previousCents, revenue.currency, true),
      since: `previous ${revenue.days} days`,
      figure: revenue.gross,
      points: revenue.sparkGross,
    })
    @!moneyCard({
      label: 'Net volume from sales',
      amount: money(revenue.net.cents, revenue.currency, true),
      previous: money(revenue.net.previousCents, revenue.currency, true),
      since: `previous ${revenue.days} days`,
      figure: revenue.net,
      points: revenue.sparkNet,
    })
    {{-- Refunds rising is not good news, so this card inverts. --}}
    @!moneyCard({
      label: 'Refunded',
      amount: money(revenue.refunded.cents, revenue.currency, true),
      previous: money(revenue.refunded.previousCents, revenue.currency, true),
      since: `previous ${revenue.days} days`,
      figure: revenue.refunded,
      points: revenue.sparkRefunded,
      good: 'down',
      tone: 'danger',
    })
  </div>

  @if(revenue.otherCurrencies.length)
    <p class="field-hint" style="margin: -10px 0 22px">
      Figures are {{ revenue.currency }} only. Also taken this period:
      @each((other, otherIndex) in revenue.otherCurrencies)
        {{ otherIndex > 0 ? ', ' : '' }}{{ money(other.netCents, other.currency) }}
      @end
      Minor units are not comparable across currencies, so they are listed rather than added.
    </p>
  @end

  <div class="panel-grid">
    {{--
      Five lines on one plot, over the same buckets. Gross, refunded and net
      are money and read against the left-hand scale; registrations and
      cancellations are counts and read against the right-hand one, dashed so
      the two kinds are not mistaken for each other. The service has already
      laid it out (`revenue.chart`), so this only prints an SVG — no library,
      and nothing to hydrate.

      Each entry in the legend switches its line on and off. The legend is a
      row of labels for checkboxes and the stylesheet does the hiding, so it
      works with the bundle blocked and from the keyboard (plan §13.3). When
      every line on one scale is off, that scale's numbers go with them.

      Hovering a bucket shows its rule and its points; the exact figures are
      in the column's <title>, which is also what a screen reader is given.
    --}}
    @let(chart = revenue.chart)
    @let(bucketNoun = revenue.bucketsAreWeekly ? 'week' : 'day')
    @let(series = [
      { key: 'gross', name: 'Gross', total: money(revenue.gross.cents, revenue.currency) },
      { key: 'refunded', name: 'Refunded', total: money(revenue.refunded.cents, revenue.currency) },
      { key: 'net', name: 'Net', total: money(revenue.net.cents, revenue.currency) },
      { key: 'registered', name: 'Registered', total: revenue.registeredInWindow, isCount: true },
      { key: 'cancelled', name: 'Cancelled', total: revenue.cancelledInWindow, isCount: true },
    ])

    @panel.root({ title: `Volume and sign-ups, by ${bucketNoun}` })
      {{-- Before the chart and the legend in the markup: the stylesheet reaches both from here. --}}
      @each(one in series)
        <input type="checkbox" class="sr-only" id="show-{{ one.key }}" checked />
      @end

      <div class="bars-wrap">
        <svg
          class="line-chart"
          viewBox="0 0 {{ chart.width }} {{ chart.height }}"
          role="img"
          aria-label="Gross, refunded and net volume, with registrations and cancellations, by {{ bucketNoun }} over the last {{ revenue.days }} days"
        >
          @each(tick in chart.ticks)
            <line class="line-chart-rule" x1="{{ chart.left }}" x2="{{ chart.right }}" y1="{{ tick.y }}" y2="{{ tick.y }}" />
          @end

          <g class="line-chart-axis-money">
            @each(tick in chart.ticks)
              <text class="line-chart-tick" x="{{ chart.left - 10 }}" y="{{ tick.y + 4 }}" text-anchor="end">{{ money(tick.cents, revenue.currency, true) }}</text>
            @end
          </g>

          <g class="line-chart-axis-count">
            @each(tick in chart.ticks)
              <text class="line-chart-tick" x="{{ chart.right + 10 }}" y="{{ tick.y + 4 }}">{{ tick.count }}</text>
            @end
          </g>

          @each(column in chart.columns)
            @if(column.showLabel)
              <text class="line-chart-tick" x="{{ column.x }}" y="{{ chart.bottom + 21 }}" text-anchor="middle">{{ column.label }}</text>
            @end
          @end

          {{-- Counts underneath, then money, net last: the line the panel is about sits on top where they cross. --}}
          <polyline class="line-chart-line line-chart-line-count series-cancelled" points="{{ chart.cancelled }}" />
          <polyline class="line-chart-line line-chart-line-count series-registered" points="{{ chart.registered }}" />
          <polyline class="line-chart-line series-refunded" points="{{ chart.refunded }}" />
          <polyline class="line-chart-line series-gross" points="{{ chart.gross }}" />
          <polyline class="line-chart-line series-net" points="{{ chart.net }}" />

          @each(column in chart.columns)
            <g class="line-chart-col">
              <title>{{ column.label }} — Gross {{ money(column.grossCents, revenue.currency) }} · Refunded {{ money(column.refundedCents, revenue.currency) }} · Net {{ money(column.netCents, revenue.currency) }} · {{ column.registered }} registered · {{ column.cancelled }} cancelled</title>
              <rect class="line-chart-hit" x="{{ column.hitX }}" y="{{ chart.top }}" width="{{ column.hitWidth }}" height="{{ chart.bottom - chart.top }}" />
              <line class="line-chart-cross" x1="{{ column.x }}" x2="{{ column.x }}" y1="{{ chart.top }}" y2="{{ chart.bottom }}" />
              <circle class="line-chart-dot series-cancelled" cx="{{ column.x }}" cy="{{ column.cancelledY }}" r="4" />
              <circle class="line-chart-dot series-registered" cx="{{ column.x }}" cy="{{ column.registeredY }}" r="4" />
              <circle class="line-chart-dot series-refunded" cx="{{ column.x }}" cy="{{ column.refundedY }}" r="4" />
              <circle class="line-chart-dot series-gross" cx="{{ column.x }}" cy="{{ column.grossY }}" r="4" />
              <circle class="line-chart-dot series-net" cx="{{ column.x }}" cy="{{ column.netY }}" r="4" />
            </g>
          @end
        </svg>
      </div>

      {{-- The legend, the totals and the switches are the same five things, so they are one row. --}}
      <div class="chart-summary">
        @each(one in series)
          <label class="chart-legend" for="show-{{ one.key }}" title="Show or hide {{ one.name.toLowerCase() }} on the chart">
            <span class="chart-summary-label">
              <i class="chart-key{{ one.isCount ? ' chart-key-dashed' : '' }} series-{{ one.key }}"></i>{{ one.name }}
            </span>
            <span class="chart-summary-value">{{ one.total }}</span>
          </label>
        @end
      </div>
    @end

    <div class="rail rail-fill">
      @panel.root({ title: 'Balance' })
        <div class="balance-section">Collected, all time</div>
        <div class="balance-row">
          <span class="balance-currency">{{ revenue.currency }}</span>
          <span class="balance-amount">
            {{ money(revenue.collectedAllTimeCents, revenue.currency) }}
          </span>
        </div>

        <div class="balance-section">Refunded, all time</div>
        <div class="balance-row">
          <span class="balance-currency">{{ revenue.currency }}</span>
          <span class="balance-amount">
            {{ money(revenue.refundedAllTimeCents, revenue.currency) }}
          </span>
        </div>
      @end

      @panel.root({ title: 'Volume by plan' })
        @if(revenue.byPlan.length)
          {{--
            Only the bar. Each section names itself — plan, amount, share —
            when the pointer is over it, or when it has focus, which is how a
            keyboard or a tap gets the same thing.
          --}}
          <div class="share-bar share-bar-hover">
            @each((plan, planIndex) in revenue.byPlan)
              <span
                class="tint-{{ (planIndex + 1) % 5 }}"
                style="width: {{ plan.percent }}%"
                tabindex="0"
                aria-label="{{ plan.name }}: {{ money(plan.cents, revenue.currency) }}, {{ plan.percent.toFixed(0) }}%"
              >
                <span class="tooltip share-tip" aria-hidden="true">
                  <i class="swatch tint-{{ (planIndex + 1) % 5 }}"></i>
                  <strong>{{ plan.name }}</strong>
                  {{ money(plan.cents, revenue.currency) }} · {{ plan.percent.toFixed(0) }}%
                </span>
              </span>
            @end
          </div>
        @else
          <p class="chart-note" style="margin-top: 0">
            Nothing was charged in this window, so there is nothing to split.
          </p>
        @end
      @end
    </div>
  </div>

  <h2 class="section-title">Growth</h2>

  {{--
    How the business moved, under what it is worth. Four events on one line,
    each against the same month before it (plan §12).
  --}}
  @panel.root({ title: 'This month', flush: true })
    <div class="snap">
      @!snapCell({ label: 'Registered', figure: growth.registered })
      @!snapCell({ label: 'Started paying', figure: growth.startedPaying })
      @!snapCell({ label: 'Renewals', figure: growth.renewals })
      @!snapCell({ label: 'Churned', figure: growth.churned, good: 'down' })
    </div>
  @end

  <p class="field-hint section-note">
    A workspace counts as <em>started paying</em> in the month its first successful payment
    landed, and every payment after that is a <em>renewal</em>. <em>Churned</em> is subscriptions
    cancelled or expired — a workspace that drops to Free is churn, one that simply goes quiet is
    not.
  </p>

  <div class="panel-grid">
    @panel.root({ title: 'Workspaces registered' })
      <div class="bars-wrap">
        <div class="bars">
          @each(month in growth.months)
            <div class="bar-col" title="{{ month.registered }} in {{ month.label }}">
              <div class="bar-value">{{ month.registered || '' }}</div>
              <div class="bar-track">
                {{--
                  The height is the only thing the server knows that the
                  stylesheet cannot: it is a share of the busiest month in the
                  window, not an absolute.
                --}}
                <div
                  class="bar-fill{{ month.isCurrent ? ' partial' : '' }}"
                  style="height: {{ month.heightPercent }}%"
                ></div>
              </div>
              <div class="bar-label">{{ month.label }}</div>
            </div>
          @end
        </div>
      </div>

      <div class="chart-summary">
        <div>
          <div class="chart-summary-label">Last 12 months</div>
          <div class="chart-summary-value">{{ growth.registeredInWindow }}</div>
        </div>
        <div>
          <div class="chart-summary-label">Monthly average</div>
          <div class="chart-summary-value">{{ growth.monthlyAverage.toFixed(1) }}</div>
        </div>
        <div>
          <div class="chart-summary-label">Best month</div>
          <div class="chart-summary-value">{{ growth.busiestMonth }}</div>
        </div>
        <span class="partial-key"><i></i> This month, still counting</span>
      </div>
    @end

    @panel.root({ title: 'Workspaces by plan' })
      <div class="share-bar">
        @each((plan, planIndex) in growth.planMix)
          @if(plan.percent > 0)
            <span class="tint-{{ planIndex % 5 }}" style="width: {{ plan.percent }}%"></span>
          @end
        @end
      </div>

      @each((plan, planIndex) in growth.planMix)
        <div class="share-row">
          <i class="swatch tint-{{ planIndex % 5 }}"></i>
          <span class="share-name">{{ plan.name }}</span>
          <span class="share-value">
            {{ plan.count }} · {{ plan.percent.toFixed(0) }}%
          </span>
        </div>
      @end

      <p class="chart-note">
        {{ growth.payingWorkspaces }} of {{ metrics.organizations }} workspaces
        {{ growth.payingWorkspaces === 1 ? 'is' : 'are' }} on a paid plan
        ({{ growth.payingPercent.toFixed(0) }}%). Counted from each workspace's current
        entitlement, so a staff override counts as the plan the customer actually has.
      </p>
    @end
  </div>

  <div class="panel-grid panel-grid-even">
    @panel.root({ title: 'Needs attention', flush: true })
      @if(attention.length)
        <div class="table-scroll">
          <table class="orders-table">
            <thead>
              <tr><th>Workspace</th><th>Status</th><th>Plan</th></tr>
            </thead>
            <tbody>
              @each(organization in attention)
                <tr>
                  <td>
                    <a class="order-id" href="{{ urlFor('admin.organizations.show', { id: organization.publicId }) }}">
                      {{ organization.name }}
                    </a>
                  </td>
                  <td>
                    @!badge({
                      text: organization.status,
                      tone: organization.status === 'suspended' ? 'danger' : 'warning',
                    })
                  </td>
                  <td>{{ organization.planKey }}</td>
                </tr>
              @end
            </tbody>
          </table>
        </div>
      @else
        @!emptyState({ icon: 'check', title: 'Nothing needs attention', description: 'No suspended or past-due workspaces.' })
      @end
    @end

    @panel.root({ title: 'Recent signups', flush: true })
      @if(signups.length)
        <div class="table-scroll">
          <table class="orders-table">
            <thead>
              <tr><th>Owner</th><th>Workspace</th><th>Joined</th></tr>
            </thead>
            <tbody>
              @each(user in signups)
                <tr>
                  <td>{{ user.email }}</td>
                  <td>
                    @if(user.organization)
                      <a class="order-id" href="{{ urlFor('admin.organizations.show', { id: user.organization.publicId }) }}">
                        {{ user.organization.name }}
                      </a>
                    @end
                  </td>
                  <td style="white-space: nowrap">{{ user.createdAt.toFormat('d LLL yyyy') }}</td>
                </tr>
              @end
            </tbody>
          </table>
        </div>
      @else
        @!emptyState({ icon: 'users', title: 'No signups yet' })
      @end
    @end
  </div>

  @panel.root({ title: 'Latest activity', flush: true })
    @slot('actions')
      @!link({ route: 'admin.audit_logs.index', text: 'Audit log', class: 'btn-ghost' })
    @end

    @if(trail.length)
      <div class="table-scroll">
        <table class="orders-table">
          <thead>
            <tr><th>Action</th><th>Actor</th><th>Subject</th><th>When</th></tr>
          </thead>
          <tbody>
            @each(entry in trail)
              <tr>
                <td><span class="order-id">{{ entry.action }}</span></td>
                <td>
                  {{ entry.metadata && entry.metadata.staffEmail ? entry.metadata.staffEmail : entry.actorType }}
                  @if(entry.isImpersonated)
                    @!badge({ text: 'impersonated', tone: 'accent' })
                  @end
                </td>
                <td class="field-hint">{{ entry.subjectId ?? '—' }}</td>
                <td style="white-space: nowrap">{{ entry.createdAt.toFormat('d LLL HH:mm') }}</td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    @else
      @!emptyState({ icon: 'list', title: 'Nothing recorded yet' })
    @end
  @end
@end
