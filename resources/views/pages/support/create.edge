{{--
  Opening a ticket (plan §21.5).

  Subject and first message are one form, because they are one thought. The
  attachment field is the ported `file_drop` component with `multiple`.
--}}
@component('layouts/app', { title: 'New support ticket' })
  <div class="new-ticket-card">
    <h2 class="section-title">What can we help with?</h2>
    <p class="section-desc">
      One question per ticket keeps the thread readable. We reply here, and email you when we do.
    </p>

    @form({ route: 'support.store', method: 'POST', enctype: 'multipart/form-data' })
      @field.root({ name: 'subject' })
        @!field.label({ text: 'Subject' })
        @!input.control({ placeholder: 'Uploads fail on files over 10 MB' })
        @!field.error()
      @end

      @field.root({ name: 'body' })
        @!field.label({ text: 'What happened' })
        @!textarea.control({
          placeholder: 'What you did, what you expected, and what happened instead.',
          rows: 8,
        })
        @!field.error()
      @end

      @field.root({ name: 'attachments' })
        @!field.label({ text: 'Screenshots' })
        @!fileDrop({
          name: 'attachments',
          multiple: true,
          accept: '.png,.jpg,.jpeg,.gif,.webp,.pdf',
          hint: `Up to ${attachmentLimit} images or PDFs, 5 MB each. They do not count against your storage.`,
        })
        @!field.error()
      @end

      <div class="form-actions btn-row">
        <a class="btn btn-outline btn-sm" href="{{ urlFor('support.index') }}">Cancel</a>
        @!button({ text: 'Send to support', type: 'submit', size: 'sm' })
      </div>
    @end
  </div>
@end
