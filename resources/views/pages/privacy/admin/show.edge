{{--
  One privacy request (plan §22.8.3): what it is, how it went, and its
  history from the audit log.

  Deliberately no download link. The archive is the customer's; staff see
  that it exists, how big it is and whether it was fetched.
--}}
@let(person = privacyRequest.user)

@component('layouts/admin', { title: privacyRequest.publicId })
  @pageHeader({
    title: `${privacyRequest.type === 'export' ? 'Data export' : 'Account deletion'} · ${privacyRequest.publicId}`,
    description: `Status: ${privacyRequest.status}`,
  })
    @slot('actions')
      @!link({ route: 'admin.privacy.index', text: 'All requests', class: 'btn btn-outline btn-sm' })
      @if(privacyRequest.type === 'export' && privacyRequest.requestedByStaffId && privacyRequest.isDownloadable && canExport)
        @!link({ route: 'admin.privacy.download', routeParams: { id: privacyRequest.publicId }, text: 'Download export', class: 'btn btn-primary btn-sm' })
      @end
      @if(privacyRequest.type === 'export' && privacyRequest.status === 'failed')
        @form({ route: 'admin.privacy.retry', routeParams: { id: privacyRequest.publicId }, method: 'POST' })
          @!button({ text: 'Retry export', type: 'submit', size: 'sm' })
        @end
      @end
      @if(privacyRequest.type === 'deletion' && privacyRequest.status === 'failed' && canErase)
        @form({ route: 'admin.privacy.retry', routeParams: { id: privacyRequest.publicId }, method: 'POST' })
          @!button({ text: 'Retry deletion', type: 'submit', size: 'sm', variant: 'danger' })
        @end
      @end
    @end
  @end

  <div class="settings-card">
    <div class="settings-row">
      <span class="settings-row-label">Person</span>
      <span class="settings-row-value">
        @if(person)
          <a href="{{ urlFor('admin.users.index') }}?q={{ encodeURIComponent(person.email) }}">{{ person.email }}</a>
        @else
          —
        @end
      </span>
    </div>
    <div class="settings-row">
      <span class="settings-row-label">Workspace</span>
      <span class="settings-row-value">
        @if(person && person.organization)
          <a href="{{ urlFor('admin.organizations.show', { id: person.organization.publicId }) }}">{{ person.organization.name }}</a>
        @else
          —
        @end
      </span>
    </div>
    <div class="settings-row">
      <span class="settings-row-label">Started by</span>
      <span class="settings-row-value">{{ privacyRequest.requestedByStaffId ? 'Staff, on the person’s behalf' : 'The person' }}</span>
    </div>
    @if(privacyRequest.staffNote)
      <div class="settings-row">
        <span class="settings-row-label">Reason given</span>
        <span class="settings-row-value">{{ privacyRequest.staffNote }}</span>
      </div>
    @end
    <div class="settings-row">
      <span class="settings-row-label">Requested</span>
      <span class="settings-row-value">{{ privacyRequest.requestedAt.toFormat('d LLL yyyy, HH:mm') }}</span>
    </div>
    <div class="settings-row">
      <span class="settings-row-label">Started</span>
      <span class="settings-row-value">{{ privacyRequest.startedAt ? privacyRequest.startedAt.toFormat('d LLL yyyy, HH:mm') : '—' }}</span>
    </div>
    <div class="settings-row">
      <span class="settings-row-label">Completed</span>
      <span class="settings-row-value">{{ privacyRequest.completedAt ? privacyRequest.completedAt.toFormat('d LLL yyyy, HH:mm') : '—' }}</span>
    </div>
    @if(privacyRequest.type === 'export')
      <div class="settings-row">
        <span class="settings-row-label">Archive</span>
        <span class="settings-row-value">
          @if(privacyRequest.exportKey)
            {{ Math.max(1, Math.round(privacyRequest.exportSizeBytes / 1024)) }} KB · available until {{ privacyRequest.exportExpiresAt.toFormat('d LLL yyyy, HH:mm') }}
          @elseif(privacyRequest.status === 'expired')
            Deleted after it expired
          @else
            —
          @end
        </span>
      </div>
      <div class="settings-row">
        <span class="settings-row-label">Downloaded</span>
        <span class="settings-row-value">{{ privacyRequest.downloadedAt ? privacyRequest.downloadedAt.toFormat('d LLL yyyy, HH:mm') : 'Not yet' }}</span>
      </div>
    @end
    @if(privacyRequest.failureReason)
      <div class="settings-row">
        <span class="settings-row-label">Why it failed</span>
        <span class="settings-row-value">{{ privacyRequest.failureReason }}</span>
      </div>
    @end
  </div>

  {{--
    The decision on a deletion (plan §22.8.2). Admin only. What approving
    would do is worked out now and shown first, so the admin decides on the
    present state of the account, not on the day it was asked.
  --}}
  @if(review)
    <div class="settings-card danger-zone">
      <h2 class="section-title">Review this deletion</h2>

      @if(privacyRequest.status === 'requested')
        <div class="info-box" style="margin-bottom: 16px">
          Waiting for the person to confirm by email. It can be approved once they have.
        </div>
      @end

      @if(review.otherMembers > 0)
        <div class="info-box info-box-warning" style="margin-bottom: 16px">
          <strong>This person owns their workspace, and {{ review.otherMembers }} other
          {{ review.otherMembers === 1 ? 'person is' : 'people are' }} in it.</strong>
          Their {{ review.otherMembers === 1 ? 'account is' : 'accounts are' }} deleted too, along
          with everything in the workspace.
        </div>
      @end

      <ul class="section-desc" style="padding-left: 18px">
        <li>Their profile row is kept, but its details are overwritten with generic ones: the email address becomes <span class="mono">email{{ privacyRequest.userId }}@deleteduser.com</span> and the name “Deleted User”. Their password, two-factor, connected accounts and avatar are removed, so they can no longer sign in.</li>
        @if(review.otherMembers > 0)
          <li><strong>Every other member of the workspace is deleted the same way</strong>, and its lists, todos and files are deleted.</li>
        @elseif(review.lastMember)
          <li><strong>They are the last member of their workspace</strong>, so its lists, todos and files are deleted too.</li>
        @else
          <li>Other people are in their workspace, so its lists, todos and files stay.</li>
        @end
        <li>Payments, subscriptions and the audit log are kept; the audit log's IP addresses and browsers for them are cleared.</li>
      </ul>

      @if(review.activeSubscription)
        <div class="info-box info-box-warning" style="margin-bottom: 16px">
          Their workspace has an <strong>{{ review.activeSubscription.status }}</strong> subscription
          ({{ review.activeSubscription.planKey }}). Deletion never touches billing, so it keeps
          charging until it is cancelled —
          @if(person && person.organization)
            <a href="{{ urlFor('admin.organizations.show', { id: person.organization.publicId }) }}">cancel it from the workspace page</a>.
          @end
        </div>
      @end

      @if(canErase)
        <div class="btn-row">
          @if(privacyRequest.status === 'confirmed')
            @form({
              route: 'admin.privacy.approve',
              routeParams: { id: privacyRequest.publicId },
              method: 'POST',
              'x-data': '',
              '@submit': "if (!confirm('Delete this account, and everything listed above with it? This cannot be undone.')) $event.preventDefault()",
            })
              @!button({ text: review.otherMembers > 0 ? 'Delete account and workspace' : 'Delete account', type: 'submit', size: 'sm', variant: 'danger' })
            @end
          @end
        </div>

        @form({ route: 'admin.privacy.reject', routeParams: { id: privacyRequest.publicId }, method: 'POST' })
          @field.root({ name: 'reason' })
            @!field.label({ text: 'Or reject it, with a reason the person will be emailed' })
            @!textarea.control({ rows: 2, maxlength: 500 })
            @!field.error()
          @end
          @!button({ text: 'Reject', type: 'submit', size: 'sm', variant: 'outline' })
        @end
      @else
        <p class="field-hint">Only an admin can approve or reject a deletion.</p>
      @end
    </div>
  @end

  {{--
    What the export holds — `data.json`, section by section. Only for an
    export an admin generated, only to an admin, and each view is audited.
    The uploaded files themselves are in the archive, not here.
  --}}
  @if(report)
    @panel.root({ title: 'Report' })
      @if(report.tooLarge)
        <p class="field-hint">This report is too large to show here. Download the export to read it.</p>
      @else
        <p class="field-hint">
          The contents of <span class="mono">data.json</span>{{ report.exportedAt ? `, as exported ${report.exportedAt}` : '' }}.
          Files the person uploaded are in the archive — download the export for those.
        </p>
        @each((section, index) in report.sections)
          <details style="margin-top: 12px" {{ index === 0 ? 'open' : '' }}>
            <summary>
              <span class="mono">{{ section.key }}</span>
              @if(section.describes)
                <span class="field-hint">— {{ section.describes }}</span>
              @end
            </summary>
            <pre class="payload-dump" style="margin-top: 8px"><code>{{ section.json }}</code></pre>
          </details>
        @end
      @end
    @end
  @end

  @if(privacyRequest.rejectionReason)
    <div class="settings-card">
      <div class="settings-row">
        <span class="settings-row-label">Rejected because</span>
        <span class="settings-row-value">{{ privacyRequest.rejectionReason }}</span>
      </div>
    </div>
  @end

  @panel.root({ title: 'History', flush: true })
    @if(trail.length)
      <div class="table-scroll">
        <table class="tx-table">
          <thead>
            <tr><th>When</th><th>What</th><th>By</th></tr>
          </thead>
          <tbody>
            @each(entry in trail)
              <tr>
                <td>{{ entry.createdAt.toFormat('d LLL yyyy, HH:mm:ss') }}</td>
                <td><span class="mono">{{ entry.action }}</span></td>
                <td>
                  @if(entry.actorType === 'staff')
                    {{ entry.metadata && entry.metadata.staffEmail ? entry.metadata.staffEmail : 'Staff' }}
                  @elseif(entry.actorType === 'user')
                    The person
                  @else
                    System
                  @end
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    @else
      @!emptyState({ icon: 'list', title: 'Nothing recorded yet' })
    @end
  @end

  <p class="field-hint">
    An export the person asked for is only ever handed to them, signed in. One started here by an
    admin is downloaded from this page instead — through a link that lasts minutes, and every
    download is audited.
  </p>
@end
