# Dependencies and AdonisJS build
node_modules
build
tmp/*
!tmp/.gitkeep

# Uploaded files on the local `fs` disk (plan §10). Deployed environments put
# these in R2 instead, so nothing here is ever part of a release.
storage/*
!storage/.gitkeep

# Secrets
.env
.env.local
.env.production.local
.env.development.local

# Frontend assets compiled code
public/assets

# The development toolbar's history — a SQLite database and a debug-data
# dump, written by adonisjs-server-stats (start/dev_toolbar.ts). Only
# `.adonisjs/server-stats`, because the codegen beside it under
# `.adonisjs/server` is committed.
.adonisjs/server-stats

# Documentation site, built from docs/ by GitHub Actions and never committed
_site
docs/.jekyll-cache

# Build tools specific
npm-debug.log
yarn-error.log

# Editors specific
.fleet
.idea
.vscode

# Platform specific
.DS_Store
